# Positive build-context allowlist. Never include a local snapshot or .env.
**
!backend/
!backend/**/
!backend/*.py
!backend/external_integrations/*.py
!backend/tests/*.py
!backend/requirements.txt
!frontend/
!frontend/**
!scripts/
!scripts/test_recovery_browser.py
!scripts/private_recovery/
!scripts/private_recovery/*.py
!scripts/private_recovery/*.sh
!scripts/private_recovery/requirements*.txt
!scripts/private_recovery/Dockerfile*
**/.env
**/.env.*
**/.git
**/node_modules
**/build
**/__pycache__
**/*.pyc
**/*.log
**/*.jsonl
**/*.bson
**/*.wt
**/*.tgz
**/*.tar
**/*.gz
**/*.zip
**/*.pem
**/*.key
**/captured-links.json
**/operator-details.json
**/selection.json
**/receipt.json
**/downloads
**/private-state
